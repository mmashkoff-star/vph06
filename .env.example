# PostgreSQL (не публикуется наружу, доступен только контейнерам в сети data)
POSTGRES_USER=deluxe
POSTGRES_PASSWORD='change-me'
POSTGRES_DB=deluxe_auto
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Документация API снаружи выключена. true — только для локальной отладки.
ENABLE_DOCS=false

# pgAdmin и registry в рабочий контур не входят (compose profiles).
# Специальные символы в пароле (например $) держите в одинарных кавычках.
PGADMIN_DEFAULT_EMAIL=admin@deluxe-auto.ru
PGADMIN_DEFAULT_PASSWORD='change-me'

# Локальный Docker Registry: docker login <SERVER_IP>:5000
REGISTRY_USER=deluxe
REGISTRY_PASSWORD='change-me'
SERVER_IP=127.0.0.1

# Секрет подписи JWT для входа в админ-панель
JWT_SECRET='change-me-jwt-secret'
